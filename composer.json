{
    "name": "spreedly/composer-sdk-server",
    "description": "Composer Server SDK for PHP",
    "type": "library",
    "keywords": [
        "composer",
        "spreedly",
        "fraud",
        "security",
        "verification"
    ],
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "Spreedly",
            "email": "support@spreedly.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "classmap": ["src/"]
    },
    "autoload-dev": {
        "psr-4": {
            "Spreedly\\ComposerSdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-slow": "phpunit --group slow",
        "test-coverage": "XDEBUG_MODE=coverage phpunit --coverage-html coverage --coverage-text"
    }
}
